# Base URL of the app (used for OAuth redirect URIs)
APP_URL=http://localhost:3000

# Postgres connection string
DATABASE_URL=postgres://user:password@host:5432/playlist_sync

# 32+ char random string. Encrypts provider tokens at rest (AES-256-GCM).
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Protects POST /api/cron/sync (Bearer token)
CRON_SECRET=change-me-too

# Spotify app credentials: https://developer.spotify.com/dashboard
# Redirect URI to register: {APP_URL}/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple developer credentials: https://developer.apple.com (MusicKit key)
# Private key is the .p8 contents, PEM format, with literal \n escapes or real newlines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
